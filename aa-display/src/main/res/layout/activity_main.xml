<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/content_padding"
        android:paddingVertical="@dimen/content_padding">

        <FrameLayout
            android:id="@+id/mcv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_card"
            android:elevation="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/content_padding">

                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_round_check_circle_24"
                    android:tint="@color/color_on_primary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_toEndOf="@id/iv_icon"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/color_on_primary"
                    android:textSize="16sp"
                    tools:text="Activated" />

                <TextView
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_active"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="2dp"
                    android:layout_toEndOf="@id/iv_icon"
                    android:textColor="@color/color_on_primary"
                    android:textSize="14sp"
                    tools:text="0.24#17.4-r1" />

            </RelativeLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mcv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_card"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/content_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="系统版本"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/system_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/mcv_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_card"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/content_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="投屏通道"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="同一时间只能投到一个通道"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rg_carplay_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_channel_aa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="Android Auto" />

                    <RadioButton
                        android:id="@+id/rb_channel_cp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="CarPlay" />
                </RadioGroup>
            </LinearLayout>
        </FrameLayout>

        <!-- Android Auto–only settings (VD DPI negotiated with gearhead). -->
        <FrameLayout
            android:id="@+id/panel_aa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_card"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/content_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Android Auto 配置"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="虚拟屏 DPI"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="留空 = 自动（车机上报值）；有效范围 120–640"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_vd_density_dpi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="留空 = 自动"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_apply_vd_density_dpi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="应用" />

                    <Button
                        android:id="@+id/btn_reset_vd_density_dpi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="恢复自动" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_vd_density_saved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    tools:text="已保存：自动" />

                <TextView
                    android:id="@+id/tv_vd_density_hu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    tools:text="车机协商：320 dpi" />

                <TextView
                    android:id="@+id/tv_vd_density_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    tools:text="当前会话：320 dpi" />

            </LinearLayout>

        </FrameLayout>

        <!-- CarPlay–only settings (session / cast). -->
        <FrameLayout
            android:id="@+id/panel_carplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_card"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/content_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CarPlay 配置"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_carplay_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    tools:text="服务：已就绪（等车机）\n画面：分屏投屏\nHost：运行中" />

                <Button
                    android:id="@+id/btn_carplay_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="40dp"
                    android:text="启动 / 重开投屏" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.aa.fragment.AaMainFragment">

    <!-- FrameLayout host: split positions panes by ratio; fullscreen stacks both MATCH_PARENT. -->
    <FrameLayout
        android:id="@+id/split_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <FrameLayout
            android:id="@+id/pane_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextureView
                android:id="@+id/tv_display_primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_empty_primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:padding="16dp"
                android:text="点击选择应用"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pane_secondary"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextureView
                android:id="@+id/tv_display_secondary"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_empty_secondary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:padding="16dp"
                android:text="点击选择应用"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <io.github.nitsuya.aa.display.ui.aa.split.SplitDividerView
            android:id="@+id/split_divider"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />
    </FrameLayout>

    <TextView
        android:id="@+id/btn_hide_ime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_hide_ime_chip"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/hide_ime"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <include
        android:id="@+id/app_picker"
        layout="@layout/view_split_app_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>

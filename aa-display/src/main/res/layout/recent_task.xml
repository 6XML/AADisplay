<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

        <!-- Gray card chrome; icon + label; × badge overlays icon corner. -->
        <View
            android:id="@+id/v_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_recent_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="H,9:16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.72" />

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="@dimen/recent_app_icon_size"
            android:layout_height="@dimen/recent_app_icon_size"
            android:layout_marginTop="14dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/tv_name"
            app:layout_constraintEnd_toEndOf="@+id/v_card"
            app:layout_constraintStart_toStartOf="@+id/v_card"
            app:layout_constraintTop_toTopOf="@+id/v_card"
            app:layout_constraintVertical_bias="0.35"
            app:layout_constraintVertical_chainStyle="packed"
            tools:src="@drawable/ic_round_check_circle_24" />

        <!-- Drawn after icon; large × centered over the icon. -->
        <ImageButton
            android:id="@+id/ib_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_recent_close_circle"
            android:contentDescription="@android:string/cancel"
            android:elevation="3dp"
            android:padding="8dp"
            android:src="@drawable/ic_close_24"
            android:tint="@color/color_recent_label"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
            app:layout_constraintEnd_toEndOf="@+id/iv_icon"
            app:layout_constraintStart_toStartOf="@+id/iv_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_icon" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/color_recent_label"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/v_card"
            app:layout_constraintEnd_toEndOf="@+id/v_card"
            app:layout_constraintStart_toStartOf="@+id/v_card"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"
            app:layout_constraintVertical_bias="1"
            tools:text="@string/app_name" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
